{
  "name": "banklang-vscode",
  "displayName": "BankLang",
  "description": "BankTS language support: banking safety diagnostics, formatting, and COBOL traceability.",
  "version": "0.9.0",
  "private": true,
  "publisher": "mwhassan",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://banklang.mwhassan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MWH997/banklang.git",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/MWH997/banklang/issues"
  },
  "qna": "https://github.com/MWH997/banklang/issues",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "keywords": [
    "cobol",
    "mainframe",
    "banking",
    "bankts",
    "zos"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:bankts"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "bankts",
        "aliases": [
          "BankTS",
          "bankts"
        ],
        "extensions": [
          ".bank.ts"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bankts",
        "scopeName": "source.bankts",
        "path": "./syntaxes/bankts.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "BankLang",
      "properties": {
        "banklang.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the BankLang language server entry point. Leave empty to use the bundled server."
        },
        "banklang.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm build:extension && pnpm build:server",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "build:server": "esbuild ../language-server/src/bin.ts --bundle --platform=node --format=cjs --outfile=server/bin.js",
    "package": "vsce package --no-dependencies --out ../../dist/vsix/"
  },
  "devDependencies": {
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
