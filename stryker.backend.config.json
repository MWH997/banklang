{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "The emitter itself: 9,263 lines that decide what COBOL a program becomes, and which no mutation lane covered until 2026-08-08. The formatting lane mutates how the text is laid out; this one mutates what the text says. Its own lane because a run over this file is long, and folding it into another would mean the two are only ever measured together.",
  "packageManager": "pnpm",
  "reporters": ["html", "clear-text", "progress", "json"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation-broad.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "packages/cobol-backend/src/index.ts",
    "packages/cobol-backend/src/align.ts"
  ],
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 60
  },
  "htmlReporter": {
    "fileName": "dist/mutation-backend/index.html"
  },
  "jsonReporter": {
    "fileName": "dist/mutation-backend/mutation.json"
  },
  "timeoutMS": 120000,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutator": {
    "excludedMutations": ["StringLiteral", "Regex"]
  },
  "ignorePatterns": ["dist", "vendor-docs", ".stryker-tmp"],
  "ignoreStatic": true,
  "concurrency": 8,
  "incremental": true,
  "incrementalFile": "dist/mutation-backend/incremental.json"
}
