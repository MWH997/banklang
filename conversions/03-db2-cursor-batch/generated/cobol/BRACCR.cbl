      *> ---------------------------------------------------------------
      *> BRACCR — BrAccr
      *>
      *> Generated by bankc from main.bank.ts.
      *> Do not edit this file directly. Source maps are in dist/maps.
      *>
      *> PURPOSE
      *>   ACCRUE-BRANCH, the transaction this program is entered at.
      *>
      *> ENTRY
      *>   A batch program, started by EXEC PGM and entered with the
      *>   job's PARM behind a halfword length: 44 characters,
      *>   positional.
      *>   branchId            X(8) (8)
      *>   idempotencyKey      X(36) (36)
      *>   A PARM shorter than that ends the step with return code 12
      *>   rather than reading past what was passed.
      *>
      *> CALLS
      *>   BANKAUDT audit trail
      *>   BANKLEDG ledger posting and rollback
      *>
      *> RETURN CODES
      *>   0   The work completed.
      *>   12  A failure the program named. BANK-FAILURE-CODE says
      *>       which.
      *>
      *> RESTART
      *>   Rerunnable. The program writes no dataset.
      *> ---------------------------------------------------------------
       IDENTIFICATION DIVISION.
       PROGRAM-ID. BRACCR.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  ACCOUNTS-IN-BRANCH-H1    PIC X(8).
           EXEC SQL END DECLARE SECTION END-EXEC.
       01  ACCOUNTS-IN-BRANCH-ROWS  PIC 9(9) COMP VALUE ZERO.
       01  BANK-FAILURE-CODE        PIC X(32) EXTERNAL.
       01  BANK-RETURN-CODE         PIC S9(4) COMP EXTERNAL.
       01  BANK-RND-1-VALUE         PIC S9(13)V99 COMP-3 VALUE ZERO.
       01  BANK-RND-1-STEP          PIC S9(13)V99 COMP-3 VALUE ZERO.
       01  BANK-RND-1-UNITS         PIC S9(15) COMP-3 VALUE ZERO.
       01  BANK-RND-1-EXCESS        PIC SV9999 COMP-3 VALUE ZERO.
           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  ACCOUNT-ROW.
           05  ROW-ACCOUNT-ID  PIC X(16).
           05  ROW-BALANCE     PIC S9(13)V99 COMP-3.
           05  ROW-STATUS      PIC X(8).
           EXEC SQL END DECLARE SECTION END-EXEC.
       01  ACCRUAL-COUNTS.
           05  ROWS-READ        PIC 9(7).
           05  ROWS-POSTED      PIC 9(7).
           05  INTEREST-POSTED  PIC S9(13)V99 COMP-3.
       01  INTEREST-ON-RESULT       PIC S9(13)V99 COMP-3 VALUE ZERO.
       01  INTEREST-ON-P1           PIC S9(13)V99 COMP-3 VALUE ZERO.
       01  INTEREST-ON-P2           PIC S9(1)V9999 COMP-3 VALUE ZERO.
       01  ACCRUE-BRANCH-P3         PIC X(8) VALUE SPACES.
       01  ACCRUE-BRANCH-P4         PIC X(36) VALUE SPACES.
       01  INTEREST                 PIC S9(13)V99 COMP-3 VALUE ZERO.
       01  BANK-LEDGER-INTERFACE.
           05  BANK-LEDGER-OPERATION  PIC X(6).
           05  BANK-LEDGER-ACCOUNT    PIC X(32).
           05  BANK-LEDGER-AMOUNT     PIC S9(16)V99 COMP-3.
       01  BANK-AUDIT-INTERFACE.
           05  BANK-AUDIT-EVENT        PIC X(32).
           05  BANK-AUDIT-CORRELATION  PIC X(64).
           EXEC SQL
               DECLARE ACCOUNTS-IN-BRANCH CURSOR FOR
               SELECT ACCOUNT_ID, BALANCE, STATUS
               FROM ACCOUNT
               WHERE BRANCH_ID = :ACCOUNTS-IN-BRANCH-H1
               ORDER BY ACCOUNT_ID
           END-EXEC.

       LINKAGE SECTION.
       01  BANK-PARM.
           05  BANK-PARM-LENGTH  PIC S9(4) COMP.
           05  BANK-PARM-DATA.
               10  BANK-PARM-BRANCH-ID        PIC X(8).
               10  BANK-PARM-IDEMPOTENCY-KEY  PIC X(36).

       PROCEDURE DIVISION USING BANK-PARM.
       BANK-MAIN.
           MOVE 0 TO BANK-RETURN-CODE
           MOVE SPACES TO BANK-FAILURE-CODE
           PERFORM BANK-ACCEPT-PARM THRU BANK-ACCEPT-PARM-EXIT
           IF BANK-RETURN-CODE = 0
               PERFORM ACCRUE-BRANCH THRU ACCRUE-BRANCH-EXIT
           END-IF
           MOVE BANK-RETURN-CODE TO RETURN-CODE
           GOBACK.
       BANK-ACCEPT-PARM.
      *> The job's PARM, positional. See the JCL for the layout.
           IF ADDRESS OF BANK-PARM = NULL
               DISPLAY "NO PARM PASSED, 44 BYTES REQUIRED" UPON SYSOUT
               MOVE 12 TO BANK-RETURN-CODE
               GO TO BANK-ACCEPT-PARM-EXIT
           END-IF
           IF BANK-PARM-LENGTH < 44
               DISPLAY "PARM IS " BANK-PARM-LENGTH " BYTES, 44 REQUIRED"
                   UPON SYSOUT
               MOVE 12 TO BANK-RETURN-CODE
               GO TO BANK-ACCEPT-PARM-EXIT
           END-IF
           MOVE BANK-PARM-BRANCH-ID TO ACCRUE-BRANCH-P3
           MOVE BANK-PARM-IDEMPOTENCY-KEY TO ACCRUE-BRANCH-P4
           CONTINUE.
       BANK-ACCEPT-PARM-EXIT.
           EXIT.
       INTEREST-ON.
           *> HALF_EVEN is generated. COBOL has
           *> only ROUNDED, which is HALF_UP.
           COMPUTE BANK-RND-1-VALUE = (INTEREST-ON-P1 * INTEREST-ON-P2)
               ON SIZE ERROR
                   DISPLAY "ARITHMETIC OVERFLOW INTEREST-ON-RESULT" UPON
                       SYSOUT
                   MOVE 12 TO BANK-RETURN-CODE
                   MOVE "ARITHMETIC-OVERFLOW" TO BANK-FAILURE-CODE
                   GO TO INTEREST-ON-EXIT
           END-COMPUTE
           COMPUTE BANK-RND-1-EXCESS =
               (INTEREST-ON-P1 * INTEREST-ON-P2) - BANK-RND-1-VALUE
           COMPUTE BANK-RND-1-STEP = 0.01
           IF BANK-RND-1-EXCESS < 0
               COMPUTE BANK-RND-1-STEP = -0.01
           END-IF
           COMPUTE BANK-RND-1-UNITS = BANK-RND-1-VALUE * 100
           EVALUATE TRUE
               WHEN FUNCTION ABS (BANK-RND-1-EXCESS) > 0.005
                   ADD BANK-RND-1-STEP TO BANK-RND-1-VALUE
               WHEN FUNCTION ABS (BANK-RND-1-EXCESS) = 0.005
                   IF FUNCTION MOD (BANK-RND-1-UNITS, 2) = 1
                       ADD BANK-RND-1-STEP TO BANK-RND-1-VALUE
                   END-IF
           END-EVALUATE
           MOVE BANK-RND-1-VALUE TO INTEREST-ON-RESULT
           CONTINUE.
       INTEREST-ON-EXIT.
           EXIT.
       ACCRUE-BRANCH.
           MOVE 0 TO ROWS-READ OF ACCRUAL-COUNTS
           MOVE 0 TO ROWS-POSTED OF ACCRUAL-COUNTS
           MOVE 0.00 TO INTEREST-POSTED OF ACCRUAL-COUNTS
           MOVE ACCRUE-BRANCH-P3 TO ACCOUNTS-IN-BRANCH-H1
           EXEC SQL
               OPEN ACCOUNTS-IN-BRANCH
           END-EXEC
           MOVE 0 TO ACCOUNTS-IN-BRANCH-ROWS
           PERFORM UNTIL ACCOUNTS-IN-BRANCH-ROWS >= 100000
               EXEC SQL
                   FETCH ACCOUNTS-IN-BRANCH
                   INTO :ROW-ACCOUNT-ID OF ACCOUNT-ROW, :ROW-BALANCE OF
                       ACCOUNT-ROW, :ROW-STATUS OF ACCOUNT-ROW
               END-EXEC
               IF SQLCODE < 0
                   DISPLAY "FETCH FAILED accountsInBranch SQLCODE "
                       SQLCODE UPON SYSOUT
                   MOVE 12 TO BANK-RETURN-CODE
                   MOVE "SQL-FETCH-FAILED" TO BANK-FAILURE-CODE
               END-IF
               IF SQLCODE NOT = 0
                   EXIT PERFORM
               END-IF
               ADD 1 TO ACCOUNTS-IN-BRANCH-ROWS
               COMPUTE ROWS-READ OF ACCRUAL-COUNTS = (ROWS-READ OF
                   ACCRUAL-COUNTS + 1)
                   ON SIZE ERROR
                       DISPLAY
                           "ARITHMETIC OVERFLOW ROWS-READ OF ACCRUAL-COU
      -                    "NTS" UPON SYSOUT
                       MOVE 12 TO BANK-RETURN-CODE
                       MOVE "ARITHMETIC-OVERFLOW" TO BANK-FAILURE-CODE
                       GO TO ACCRUE-BRANCH-EXIT
               END-COMPUTE
               IF ROW-STATUS OF ACCOUNT-ROW = "OPEN"
                   MOVE ROW-BALANCE OF ACCOUNT-ROW TO INTEREST-ON-P1
                   MOVE 0.0025 TO INTEREST-ON-P2
                   PERFORM INTEREST-ON THRU INTEREST-ON-EXIT
                   IF BANK-FAILURE-CODE NOT = SPACES
                       GO TO ACCRUE-BRANCH-EXIT
                   END-IF
                   MOVE INTEREST-ON-RESULT TO INTEREST
                   MOVE "CREDIT" TO BANK-LEDGER-OPERATION
                   MOVE ROW-ACCOUNT-ID OF ACCOUNT-ROW TO
                       BANK-LEDGER-ACCOUNT
                   MOVE INTEREST TO BANK-LEDGER-AMOUNT
                   CALL "BANKLEDG" USING BANK-LEDGER-INTERFACE
                   MOVE "DEBIT" TO BANK-LEDGER-OPERATION
                   MOVE "INTEREST-EXPENSE" TO BANK-LEDGER-ACCOUNT
                   MOVE INTEREST TO BANK-LEDGER-AMOUNT
                   CALL "BANKLEDG" USING BANK-LEDGER-INTERFACE
                   COMPUTE ROWS-POSTED OF ACCRUAL-COUNTS = (ROWS-POSTED
                       OF ACCRUAL-COUNTS + 1)
                       ON SIZE ERROR
                           DISPLAY
                               "ARITHMETIC OVERFLOW ROWS-POSTED OF ACCRU
      -                        "AL-COUNTS" UPON SYSOUT
                           MOVE 12 TO BANK-RETURN-CODE
                           MOVE "ARITHMETIC-OVERFLOW" TO
                               BANK-FAILURE-CODE
                           GO TO ACCRUE-BRANCH-EXIT
                   END-COMPUTE
                   COMPUTE INTEREST-POSTED OF ACCRUAL-COUNTS =
                       (INTEREST-POSTED OF ACCRUAL-COUNTS + INTEREST)
                       ON SIZE ERROR
                           DISPLAY
                               "ARITHMETIC OVERFLOW INTEREST-POSTED OF A
      -                        "CCRUAL-COUNTS" UPON SYSOUT
                           MOVE 12 TO BANK-RETURN-CODE
                           MOVE "ARITHMETIC-OVERFLOW" TO
                               BANK-FAILURE-CODE
                           GO TO ACCRUE-BRANCH-EXIT
                   END-COMPUTE
               END-IF
           END-PERFORM
           IF ACCOUNTS-IN-BRANCH-ROWS >= 100000 AND SQLCODE = 0
               DISPLAY "CURSOR LIMIT 100000 REACHED, ROWS UNREAD" UPON
                   SYSOUT
               MOVE 12 TO BANK-RETURN-CODE
               MOVE "BANK-LOOP-EXHAUSTED" TO BANK-FAILURE-CODE
           END-IF
           EXEC SQL
               CLOSE ACCOUNTS-IN-BRANCH
           END-EXEC
           IF BANK-FAILURE-CODE NOT = SPACES
               GO TO ACCRUE-BRANCH-EXIT
           END-IF
           EXEC SQL
               COMMIT
           END-EXEC
           DISPLAY "ROWS   " ROWS-READ OF ACCRUAL-COUNTS UPON SYSOUT
           DISPLAY "POSTED " ROWS-POSTED OF ACCRUAL-COUNTS UPON SYSOUT
           MOVE "BRANCH_ACCRUED" TO BANK-AUDIT-EVENT
           MOVE ACCRUE-BRANCH-P4 TO BANK-AUDIT-CORRELATION
           CALL "BANKAUDT" USING BANK-AUDIT-INTERFACE
           CONTINUE.
       ACCRUE-BRANCH-EXIT.
           EXIT.
