      *> ---------------------------------------------------------------
      *> ACCTENQ — AcctEnq
      *>
      *> Generated by bankc from main.bank.ts.
      *> Do not edit this file directly. Source maps are in dist/maps.
      *>
      *> PURPOSE
      *>   ENQUIRE-ACCOUNT, the transaction this program is entered at.
      *>
      *> ENTRY
      *>   A CICS transaction, started by a transaction identifier in a
      *>   region rather than by EXEC PGM in a job.
      *>   DFHCOMMAREA holds COMMAREA-LAYOUT, and EIBCALEN is tested
      *>   against its length before anything reads it.
      *>
      *> CALLS
      *>   BANKAUDT audit trail
      *>
      *> RETURN CODES
      *>   0   The work completed.
      *>   12  Not used under CICS. A failure abends the task with code
      *>       BLNG.
      *>
      *> RESTART
      *>   Rerunnable. The program writes no dataset.
      *> ---------------------------------------------------------------
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ACCTENQ.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  FETCH-ACCOUNT-H1   PIC X(16).
           EXEC SQL END DECLARE SECTION END-EXEC.
       01  WRITE-RESP         PIC S9(8) COMP VALUE ZERO.
       01  BANK-FAILURE-CODE  PIC X(32) EXTERNAL.
       01  BANK-RETURN-CODE   PIC S9(4) COMP EXTERNAL.
       01  COMMAREA-LAYOUT.
           05  CA-ACCT-NO       PIC X(16).
           05  CA-BALANCE       PIC S9(13)V99 COMP-3.
           05  CA-RETURN-CODE   PIC X(2).
           05  IDEMPOTENCY-KEY  PIC X(36).
           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  ACCOUNT-ROW.
           05  ROW-BALANCE  PIC S9(13)V99 COMP-3.
           05  ROW-STATUS   PIC X(1).
           EXEC SQL END DECLARE SECTION END-EXEC.
       01  BANK-AUDIT-INTERFACE.
           05  BANK-AUDIT-EVENT        PIC X(32).
           05  BANK-AUDIT-CORRELATION  PIC X(64).

       LINKAGE SECTION.
       01  DFHCOMMAREA.
           05  LK-CA-ACCT-NO       PIC X(16).
           05  LK-CA-BALANCE       PIC S9(13)V99 COMP-3.
           05  LK-CA-RETURN-CODE   PIC X(2).
           05  LK-IDEMPOTENCY-KEY  PIC X(36).

       PROCEDURE DIVISION.
       BANK-MAIN.
           MOVE 0 TO BANK-RETURN-CODE
           MOVE SPACES TO BANK-FAILURE-CODE
           PERFORM ENQUIRE-ACCOUNT THRU ENQUIRE-ACCOUNT-EXIT
           IF BANK-RETURN-CODE NOT = 0
               EXEC CICS ABEND ABCODE("BLNG") END-EXEC
           END-IF
           EXEC CICS RETURN END-EXEC
           GOBACK.
       ENQUIRE-ACCOUNT.
           IF EIBCALEN < LENGTH OF DFHCOMMAREA
               EXEC CICS ABEND ABCODE("BKNC") END-EXEC
           END-IF
           MOVE DFHCOMMAREA TO COMMAREA-LAYOUT
           MOVE CA-ACCT-NO OF COMMAREA-LAYOUT TO FETCH-ACCOUNT-H1
           EXEC SQL
               SELECT BALANCE, STATUS
               INTO :ROW-BALANCE OF ACCOUNT-ROW, :ROW-STATUS OF
                   ACCOUNT-ROW
               FROM ACCOUNT
               WHERE ACCOUNT_ID = :FETCH-ACCOUNT-H1
           END-EXEC
           IF SQLCODE < 0
               MOVE 0.00 TO CA-BALANCE OF COMMAREA-LAYOUT
               MOVE "09" TO CA-RETURN-CODE OF COMMAREA-LAYOUT
               DISPLAY "SQL ERROR " SQLCODE UPON SYSOUT
           ELSE
               IF SQLCODE = 0
                   MOVE ROW-BALANCE OF ACCOUNT-ROW TO CA-BALANCE OF
                       COMMAREA-LAYOUT
                   MOVE "00" TO CA-RETURN-CODE OF COMMAREA-LAYOUT
               ELSE
                   MOVE 0.00 TO CA-BALANCE OF COMMAREA-LAYOUT
                   MOVE "01" TO CA-RETURN-CODE OF COMMAREA-LAYOUT
               END-IF
           END-IF
           EXEC CICS WRITEQ TS QUEUE("CSMT") FROM(COMMAREA-LAYOUT)
               RESP(WRITE-RESP) END-EXEC
           IF WRITE-RESP NOT = DFHRESP(NORMAL)
               MOVE "02" TO CA-RETURN-CODE OF COMMAREA-LAYOUT
           END-IF
           MOVE "ACCOUNT_ENQUIRED" TO BANK-AUDIT-EVENT
           MOVE IDEMPOTENCY-KEY OF COMMAREA-LAYOUT TO
               BANK-AUDIT-CORRELATION
           CALL "BANKAUDT" USING BANK-AUDIT-INTERFACE
           MOVE COMMAREA-LAYOUT TO DFHCOMMAREA
           CONTINUE.
       ENQUIRE-ACCOUNT-EXIT.
           EXIT.
