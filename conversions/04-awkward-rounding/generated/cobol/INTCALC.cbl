      *> ---------------------------------------------------------------
      *> INTCALC — IntCalc
      *>
      *> Generated by bankc from main.bank.ts.
      *> Do not edit this file directly. Source maps are in dist/maps.
      *>
      *> PURPOSE
      *>   CALCULATE-INTEREST, the transaction this program is entered
      *>     at.
      *>
      *> ENTRY
      *>   A batch program with no parameters, started by EXEC PGM in a
      *>     job.
      *>
      *> CALLS
      *>   BANKAUDT audit trail
      *>
      *> RETURN CODES
      *>   0   The work completed.
      *>   12  A failure the program named. BANK-FAILURE-CODE says
      *>     which.
      *>
      *> RESTART
      *>   Rerunnable. The program writes no dataset.
      *> ---------------------------------------------------------------
       IDENTIFICATION DIVISION.
       PROGRAM-ID. INTCALC.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  BANK-FAILURE-CODE    PIC X(32) EXTERNAL.
       01  BANK-RETURN-CODE     PIC S9(4) COMP EXTERNAL.
       01  BANK-RND-1-VALUE     PIC S9(13)V99 COMP-3.
       01  BANK-RND-1-STEP      PIC S9(13)V99 COMP-3.
       01  BANK-RND-1-UNITS     PIC S9(15) COMP-3.
       01  BANK-RND-1-EXCESS    PIC SV9999 COMP-3.
       01  INTEREST-REQUEST.
           05  BALANCE              PIC S9(13)V99 COMP-3.
           05  INTEREST             PIC S9(13)V99 COMP-3.
           05  IDEMPOTENCY-KEY      PIC X(36).
       01  RATE-FOR-RESULT PIC S9(1)V9999 COMP-3.
       01  RATE-FOR-P1          PIC S9(13)V99 COMP-3.
       01  INTEREST-ON-RESULT PIC S9(13)V99 COMP-3.
       01  INTEREST-ON-P1       PIC S9(13)V99 COMP-3.
       01  BANK-LEDGER-INTERFACE.
           05  BANK-LEDGER-OPERATION    PIC X(6).
           05  BANK-LEDGER-ACCOUNT      PIC X(32).
           05  BANK-LEDGER-AMOUNT       PIC S9(16)V99 COMP-3.
       01  BANK-AUDIT-INTERFACE.
           05  BANK-AUDIT-EVENT         PIC X(32).
           05  BANK-AUDIT-CORRELATION   PIC X(64).

       PROCEDURE DIVISION.
       BANK-MAIN.
           MOVE 0 TO BANK-RETURN-CODE
           MOVE SPACES TO BANK-FAILURE-CODE
           PERFORM CALCULATE-INTEREST THRU CALCULATE-INTEREST-EXIT
           MOVE BANK-RETURN-CODE TO RETURN-CODE
           GOBACK.
       RATE-FOR.
           IF RATE-FOR-P1 <= 100000.00
               MOVE 0.0125 TO RATE-FOR-RESULT
           ELSE
               IF RATE-FOR-P1 <= 500000.00
                   MOVE 0.0250 TO RATE-FOR-RESULT
               ELSE
                   MOVE 0.0375 TO RATE-FOR-RESULT
               END-IF
           END-IF
           CONTINUE.
       RATE-FOR-EXIT.
           EXIT.
       INTEREST-ON.
           MOVE INTEREST-ON-P1 TO RATE-FOR-P1
           PERFORM RATE-FOR THRU RATE-FOR-EXIT
           IF BANK-FAILURE-CODE NOT = SPACES
               GO TO INTEREST-ON-EXIT
           END-IF
           *> HALF_EVEN is generated. COBOL has
           *> only ROUNDED, which is HALF_UP.
           COMPUTE BANK-RND-1-VALUE = (INTEREST-ON-P1 * RATE-FOR-RESULT)
               ON SIZE ERROR
                   DISPLAY "ARITHMETIC OVERFLOW INTEREST-ON-RESULT" UPON
                       SYSOUT
                   MOVE 12 TO BANK-RETURN-CODE
                   MOVE "ARITHMETIC-OVERFLOW" TO BANK-FAILURE-CODE
                   GO TO INTEREST-ON-EXIT
           END-COMPUTE
           COMPUTE BANK-RND-1-EXCESS =
               (INTEREST-ON-P1 * RATE-FOR-RESULT) - BANK-RND-1-VALUE
           COMPUTE BANK-RND-1-STEP = 0.01
           IF BANK-RND-1-EXCESS < 0
               COMPUTE BANK-RND-1-STEP = -0.01
           END-IF
           COMPUTE BANK-RND-1-UNITS = BANK-RND-1-VALUE * 100
           EVALUATE TRUE
               WHEN FUNCTION ABS (BANK-RND-1-EXCESS) > 0.005
                   ADD BANK-RND-1-STEP TO BANK-RND-1-VALUE
               WHEN FUNCTION ABS (BANK-RND-1-EXCESS) = 0.005
                   IF FUNCTION MOD (BANK-RND-1-UNITS, 2) = 1
                       ADD BANK-RND-1-STEP TO BANK-RND-1-VALUE
                   END-IF
           END-EVALUATE
           MOVE BANK-RND-1-VALUE TO INTEREST-ON-RESULT
           CONTINUE.
       INTEREST-ON-EXIT.
           EXIT.
       CALCULATE-INTEREST.
           MOVE BALANCE OF INTEREST-REQUEST TO INTEREST-ON-P1
           PERFORM INTEREST-ON THRU INTEREST-ON-EXIT
           IF BANK-FAILURE-CODE NOT = SPACES
               GO TO CALCULATE-INTEREST-EXIT
           END-IF
           MOVE INTEREST-ON-RESULT TO INTEREST OF INTEREST-REQUEST
           DISPLAY "BALANCE  " BALANCE OF INTEREST-REQUEST UPON SYSOUT
           DISPLAY "INTEREST " INTEREST OF INTEREST-REQUEST UPON SYSOUT
           MOVE "INTEREST_CALCULATED" TO BANK-AUDIT-EVENT
           MOVE IDEMPOTENCY-KEY OF INTEREST-REQUEST TO
               BANK-AUDIT-CORRELATION
           CALL "BANKAUDT" USING BANK-AUDIT-INTERFACE
           CONTINUE.
       CALCULATE-INTEREST-EXIT.
           EXIT.
