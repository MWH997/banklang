{
  "name": "banklang",
  "version": "0.9.0",
  "description": "A deterministic compiler from BankTS, a small banking language with TypeScript's type syntax, to readable IBM Enterprise COBOL.",
  "license": "MIT",
  "homepage": "https://banklang.mwhassan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MWH997/banklang.git"
  },
  "bugs": {
    "url": "https://github.com/MWH997/banklang/issues"
  },
  "keywords": [
    "cobol",
    "ibm-enterprise-cobol",
    "mainframe",
    "zos",
    "compiler",
    "banking",
    "cics",
    "db2",
    "jcl"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bankc": "tsx packages/bankc-cli/src/bin.ts",
    "build:blog": "tsx tools/build-blog.ts",
    "build:docs": "tsx tools/build-docs.ts",
    "build:icon": "tsx tools/build-icon.ts",
    "build:og": "tsx tools/build-og.ts",
    "build:site": "tsx tools/build-site.ts",
    "build:vsix": "tsx tools/build-vsix.ts",
    "conversions:refresh": "tsx tools/refresh-conversions.ts",
    "docs:citations": "tsx tools/check-citations.ts",
    "doctor": "pnpm bankc doctor",
    "emit:cobol": "pnpm bankc emit cobol examples/account-transfer",
    "emit:copybooks": "pnpm bankc emit copybooks examples/account-transfer",
    "evidence:grades": "tsx tools/evidence-grades.ts",
    "evidence:refresh": "tsx tools/refresh-evidence.ts",
    "examples:verify": "tsx tools/verify-examples.ts",
    "fixtures:refresh": "tsx tools/refresh-fixtures.ts",
    "fmt": "tsx tools/format-examples.ts",
    "fmt:check": "tsx tools/format-examples.ts --check",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "horizontal:analyse": "tsx tools/horizontal-analyse.ts",
    "horizontal:ccvs85": "tsx tools/horizontal-ccvs85.ts",
    "horizontal:fetch": "tsx tools/horizontal-fetch.ts",
    "horizontal:materialise": "tsx tools/horizontal-materialise.ts",
    "horizontal:report": "tsx tools/horizontal-report.ts",
    "horizontal:run": "tsx tools/horizontal-run.ts",
    "lint": "eslint .",
    "lint:conformance": "tsx tools/conformance-lint.ts",
    "lint:fix": "eslint . --fix",
    "lint:zos": "tsx tools/zos-lint.ts",
    "lsp": "tsx packages/language-server/src/bin.ts",
    "playground:budget": "tsx tools/bundle-budget.ts",
    "playground:build": "pnpm --filter @banklang/playground build",
    "playground:dev": "pnpm --filter @banklang/playground dev",
    "playground:links": "tsx tools/playground-links.ts",
    "playground:links:check": "tsx tools/playground-links.ts --check",
    "playground:preview": "pnpm --filter @banklang/playground preview",
    "release:notes": "tsx tools/release-notes.ts",
    "sbom:build": "tsx tools/sbom.ts",
    "sbom:check": "tsx tools/sbom.ts --check",
    "sbom:release": "tsx tools/sbom.ts --all-platforms",
    "test": "vitest run",
    "test:determinism": "vitest run tests/determinism.test.ts",
    "test:gnucobol": "tsx tools/gnucobol-validation.ts",
    "test:mutation": "stryker run",
    "test:mutation:backend": "stryker run stryker.backend.config.json",
    "test:mutation:emitter": "stryker run stryker.emitter.config.json",
    "test:mutation:lint": "stryker run stryker.lint.config.json",
    "test:mutation:runtime": "stryker run stryker.runtime.config.json",
    "test:mutation:tools": "stryker run stryker.tools.config.json",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "words:extract": "tsx tools/extract-ibm-words.ts",
    "zos:kit": "tsx tools/zos-kit.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "markdown-it": "^15.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
