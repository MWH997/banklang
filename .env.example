# BankLang local environment.
#
#   cp .env.example .env
#
# `.env` is ignored and must stay that way. Nothing in this repository requires
# an environment variable to build, test or run: the compiler makes no network
# call and reads no configuration from the environment. What is here is the
# validation toolchain and the deploy.
#
# Every variable a working `.env` holds is listed here, with an empty value.
# `tests/environment.test.ts` compares the two when a `.env` is present, because
# a key that exists locally and is documented nowhere is a setup step the next
# person has to guess.

# ---------------------------------------------------------------------------
# GnuCOBOL
# ---------------------------------------------------------------------------

# Path to `cobc`. Leave blank and the toolchain looks for it on PATH; the tests
# that need it skip when it is not there rather than failing.
GNUCOBOL_COBC_PATH=

# ---------------------------------------------------------------------------
# IBM Enterprise COBOL
# ---------------------------------------------------------------------------

# No claim in this repository rests on IBM Enterprise COBOL. Everything is
# validated with GnuCOBOL, under a dialect shaped to Enterprise COBOL 6.4 and
# under GnuCOBOL's own default, and docs/status-and-limits.md says so plainly.
#
# Set this only inside a controlled validation lab, and never commit the site
# details that go with it. zos/README.md describes what such a run produces.
IBM_ENTERPRISE_COBOL_VALIDATION_ENABLED=false

# ---------------------------------------------------------------------------
# Cloudflare — Pages, DNS and R2
# ---------------------------------------------------------------------------
#
# For deploying the site and for R2 through its S3-compatible API. Nothing in
# the compiler reads any of these: `pnpm build:site` writes `dist/site` and
# makes no network call. They are here for the deploy, and for `wrangler`.
#
# The API token wants the narrowest scope that does the job — for Pages, that is
# an account-scoped token with `Cloudflare Pages: Edit` and nothing else. A
# global API key belongs in none of these.

# Account → the ID shown on any zone's overview page.
CLOUDFLARE_ACCOUNT_ID=

# Scoped API token, created under My Profile → API Tokens.
CLOUDFLARE_API_TOKEN=

# R2's S3-compatible credentials, which are a separate pair from the API token
# above and are created under R2 → Manage R2 API Tokens.
CLOUDFLARE_ACCOUNT_ACCESS_KEY_ID=
CLOUDFLARE_ACCOUNT_ACCESS_KEY_SECRET=

# https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_S3_API_ENDPOINT=
