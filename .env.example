# BankLang local environment example
#
# Copy this file to .env for local use:
#
#   cp .env.example .env
#
# Never commit .env.
# Never paste real API keys into issue comments, AI review logs, tester notes, or docs.

# ---------------------------------------------------------------------------
# Google AI Studio / a model API
# ---------------------------------------------------------------------------

# Required only if the assistant delegates bounded tasks to a model/a model through the a model API.
MODEL_API_KEY=

# High-volume free workhorse candidates, based on user's AI Studio observed quotas.
MODEL_WORKHORSE_MODEL=a model-4-31b-it
MODEL_FALLBACK_MODEL=a model-4-26b-a4b-it

# Scarce specialist model for hard review/high-risk reasoning.
MODEL_SPECIALIST_MODEL=a model-2.5-flash

# External API calls should be disabled by default until privacy/rate-limit checks are complete.
AI_EXTERNAL_CALLS_ENABLED=false

# Conservative defaults for external model calls.
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_REQUESTS_PER_DAY=100
AI_REQUEST_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Local a model
# ---------------------------------------------------------------------------

# Optional local review model.
MODEL_BASE_URL=http://localhost:11434
MODEL_REVIEW_MODEL=

# Examples:
# MODEL_REVIEW_MODEL=qwen2.5-coder:14b
# MODEL_REVIEW_MODEL=deepseek-coder-v2:16b

# ---------------------------------------------------------------------------
# Validation tooling
# ---------------------------------------------------------------------------

# Optional path to GnuCOBOL compiler.
# Leave blank and let scripts auto-detect `cobc` if installed.
GNUCOBOL_COBC_PATH=

# IBM Enterprise COBOL validation is never assumed.
# Set only in a controlled validation lab and never commit private environment details.
IBM_ENTERPRISE_COBOL_VALIDATION_ENABLED=false

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------

# Repo creation should use the authenticated `gh` CLI.
# Do not put GitHub tokens here unless absolutely necessary for local automation.
GITHUB_REPOSITORY_VISIBILITY=private
