       IDENTIFICATION DIVISION.
       PROGRAM-ID. WITHDRAW.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT REQUEST-INPUT-FILE ASSIGN TO REQUESTI
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS REQUEST-STATUS.
           SELECT RESULT-OUTPUT-FILE ASSIGN TO RESULTOU
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS RESULT-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  REQUEST-INPUT-FILE
           BLOCK CONTAINS 0 RECORDS
           RECORDING MODE IS F.
       01  REQUEST-INPUT-RECORD.
           05  ACCOUNT-ID       PIC X(16).
           05  BALANCE          PIC S9(16)V99 COMP-3.
           05  IDEMPOTENCY-KEY  PIC X(36).
           05  MINIMUM-BALANCE  PIC S9(16)V99 COMP-3.
           05  REQUESTED        PIC S9(16)V99 COMP-3.
       FD  RESULT-OUTPUT-FILE
           BLOCK CONTAINS 0 RECORDS
           RECORDING MODE IS F.
       01  RESULT-OUTPUT-RECORD.
           05  ACCOUNT-ID       PIC X(16).
           05  PAID-OUT         PIC S9(16)V99 COMP-3.
           05  CLOSING-BALANCE  PIC S9(16)V99 COMP-3.
           05  IDEMPOTENCY-KEY  PIC X(36).
       WORKING-STORAGE SECTION.
       01  REQUEST-STATUS            PIC X(2) VALUE SPACES.
           88  REQUEST-STATUS-OK      VALUE "00" THRU "09".
           88  REQUEST-STATUS-EOF     VALUE "10".
           88  REQUEST-STATUS-DUPKEY  VALUE "22".
           88  REQUEST-STATUS-NOTFND  VALUE "23".
       01  RESULT-STATUS             PIC X(2) VALUE SPACES.
           88  RESULT-STATUS-OK      VALUE "00" THRU "09".
           88  RESULT-STATUS-EOF     VALUE "10".
           88  RESULT-STATUS-DUPKEY  VALUE "22".
           88  RESULT-STATUS-NOTFND  VALUE "23".
       01  BANK-FAILURE-CODE         PIC X(32) EXTERNAL.
       01  BANK-RETURN-CODE          PIC S9(4) COMP EXTERNAL.
       01  CURRENT-ACCOUNT.
           05  ACCOUNT-ID       PIC X(16).
           05  BALANCE          PIC S9(16)V99 COMP-3.
           05  IDEMPOTENCY-KEY  PIC X(36).
       01  SAVINGS-ACCOUNT.
           05  ACCOUNT-ID       PIC X(16).
           05  BALANCE          PIC S9(16)V99 COMP-3.
           05  IDEMPOTENCY-KEY  PIC X(36).
           05  MINIMUM-BALANCE  PIC S9(16)V99 COMP-3.
           05  REQUESTED        PIC S9(16)V99 COMP-3.
       01  WITHDRAWAL-RESULT.
           05  ACCOUNT-ID       PIC X(16).
           05  PAID-OUT         PIC S9(16)V99 COMP-3.
           05  CLOSING-BALANCE  PIC S9(16)V99 COMP-3.
           05  IDEMPOTENCY-KEY  PIC X(36).
       01  LEDGER-BALANCE-OF-RESULT  PIC S9(16)V99 COMP-3 VALUE ZERO.
       01  PERMITTED-AMOUNT-RESULT   PIC S9(16)V99 COMP-3 VALUE ZERO.
       01  PERMITTED-AMOUNT-P2       PIC S9(16)V99 COMP-3 VALUE ZERO.
       01  ALLOWED                   PIC S9(16)V99 COMP-3 VALUE ZERO.
       01  BANK-LEDGER-INTERFACE.
           05  BANK-LEDGER-OPERATION  PIC X(6).
           05  BANK-LEDGER-ACCOUNT    PIC X(32).
           05  BANK-LEDGER-AMOUNT     PIC S9(16)V99 COMP-3.
       01  BANK-AUDIT-INTERFACE.
           05  BANK-AUDIT-EVENT        PIC X(32).
           05  BANK-AUDIT-CORRELATION  PIC X(64).

       LINKAGE SECTION.
       01  LEDGER-BALANCE-OF-P1.
           05  ACCOUNT-ID       PIC X(16).
           05  BALANCE          PIC S9(16)V99 COMP-3.
           05  IDEMPOTENCY-KEY  PIC X(36).
       01  PERMITTED-AMOUNT-P1.
           05  ACCOUNT-ID       PIC X(16).
           05  BALANCE          PIC S9(16)V99 COMP-3.
           05  IDEMPOTENCY-KEY  PIC X(36).
           05  MINIMUM-BALANCE  PIC S9(16)V99 COMP-3.
           05  REQUESTED        PIC S9(16)V99 COMP-3.

       PROCEDURE DIVISION.
       DECLARATIVES.
       REQUEST-INPUT-ERROR-SECTION SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON REQUEST-INPUT-FILE.
       REQUEST-INPUT-ERROR.
           DISPLAY "REQUESTINPUT FAILED, STATUS " REQUEST-STATUS UPON
               SYSOUT
           MOVE 12 TO BANK-RETURN-CODE
           CONTINUE.
       RESULT-OUTPUT-ERROR-SECTION SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON RESULT-OUTPUT-FILE.
       RESULT-OUTPUT-ERROR.
           DISPLAY "RESULTOUTPUT FAILED, STATUS " RESULT-STATUS UPON
               SYSOUT
           MOVE 12 TO BANK-RETURN-CODE
           CONTINUE.
       END DECLARATIVES.
       BANK-BODY SECTION.
       BANK-MAIN.
           MOVE 0 TO BANK-RETURN-CODE
           MOVE SPACES TO BANK-FAILURE-CODE
           PERFORM WITHDRAW THRU WITHDRAW-EXIT
           MOVE BANK-RETURN-CODE TO RETURN-CODE
           GOBACK.
       LEDGER-BALANCE-OF.
           MOVE BALANCE OF LEDGER-BALANCE-OF-P1 TO
               LEDGER-BALANCE-OF-RESULT
           CONTINUE.
       LEDGER-BALANCE-OF-EXIT.
           EXIT.
       PERMITTED-AMOUNT.
           IF PERMITTED-AMOUNT-P2 <= 0.00
               MOVE "NON_POSITIVE_AMOUNT" TO BANK-FAILURE-CODE
               GO TO PERMITTED-AMOUNT-EXIT
           END-IF
           IF (BALANCE OF PERMITTED-AMOUNT-P1 - PERMITTED-AMOUNT-P2) <
               MINIMUM-BALANCE OF PERMITTED-AMOUNT-P1
               MOVE "BELOW_MINIMUM_BALANCE" TO BANK-FAILURE-CODE
               GO TO PERMITTED-AMOUNT-EXIT
           END-IF
           MOVE PERMITTED-AMOUNT-P2 TO PERMITTED-AMOUNT-RESULT
           CONTINUE.
       PERMITTED-AMOUNT-EXIT.
           EXIT.
       WITHDRAW.
           MOVE SPACES TO BANK-FAILURE-CODE
           PERFORM WITHDRAW-BODY THRU WITHDRAW-BODY-EXIT
           IF BANK-FAILURE-CODE NOT = SPACES
               PERFORM WITHDRAW-FAILURE THRU WITHDRAW-FAILURE-EXIT
           END-IF
           CONTINUE.
       WITHDRAW-EXIT.
           EXIT.
       WITHDRAW-BODY.
           OPEN INPUT REQUEST-INPUT-FILE
           IF NOT REQUEST-STATUS-OK
               DISPLAY "OPEN FAILED requestInput STATUS " REQUEST-STATUS
                   UPON SYSOUT
               MOVE 12 TO BANK-RETURN-CODE
               MOVE "OPEN-FAILED" TO BANK-FAILURE-CODE
               GO TO WITHDRAW-BODY-EXIT
           END-IF
           READ REQUEST-INPUT-FILE
               AT END MOVE "10" TO REQUEST-STATUS
               NOT AT END
                   MOVE ACCOUNT-ID OF REQUEST-INPUT-RECORD TO ACCOUNT-ID
                       OF SAVINGS-ACCOUNT
                   MOVE BALANCE OF REQUEST-INPUT-RECORD TO BALANCE OF
                       SAVINGS-ACCOUNT
                   MOVE IDEMPOTENCY-KEY OF REQUEST-INPUT-RECORD TO
                       IDEMPOTENCY-KEY OF SAVINGS-ACCOUNT
                   MOVE MINIMUM-BALANCE OF REQUEST-INPUT-RECORD TO
                       MINIMUM-BALANCE OF SAVINGS-ACCOUNT
                   MOVE REQUESTED OF REQUEST-INPUT-RECORD TO REQUESTED
                       OF SAVINGS-ACCOUNT
           END-READ
           IF NOT REQUEST-STATUS-OK AND NOT REQUEST-STATUS-EOF
               DISPLAY "READ FAILED requestInput STATUS " REQUEST-STATUS
                   UPON SYSOUT
               MOVE 12 TO BANK-RETURN-CODE
               MOVE "READ-FAILED" TO BANK-FAILURE-CODE
               GO TO WITHDRAW-BODY-EXIT
           END-IF
           CLOSE REQUEST-INPUT-FILE
           IF NOT REQUEST-STATUS-OK
               DISPLAY "CLOSE FAILED requestInput STATUS "
                   REQUEST-STATUS UPON SYSOUT
               MOVE 12 TO BANK-RETURN-CODE
               MOVE "CLOSE-FAILED" TO BANK-FAILURE-CODE
               GO TO WITHDRAW-BODY-EXIT
           END-IF
           SET ADDRESS OF PERMITTED-AMOUNT-P1 TO ADDRESS OF
               SAVINGS-ACCOUNT
           MOVE REQUESTED OF SAVINGS-ACCOUNT TO PERMITTED-AMOUNT-P2
           PERFORM PERMITTED-AMOUNT THRU PERMITTED-AMOUNT-EXIT
           IF BANK-FAILURE-CODE NOT = SPACES
               GO TO WITHDRAW-BODY-EXIT
           END-IF
           MOVE PERMITTED-AMOUNT-RESULT TO ALLOWED
           MOVE "DEBIT" TO BANK-LEDGER-OPERATION
           MOVE ACCOUNT-ID OF SAVINGS-ACCOUNT TO BANK-LEDGER-ACCOUNT
           MOVE ALLOWED TO BANK-LEDGER-AMOUNT
           CALL "BANKLEDG" USING BANK-LEDGER-INTERFACE
           MOVE "CREDIT" TO BANK-LEDGER-OPERATION
           MOVE "BRANCH-TILL" TO BANK-LEDGER-ACCOUNT
           MOVE ALLOWED TO BANK-LEDGER-AMOUNT
           CALL "BANKLEDG" USING BANK-LEDGER-INTERFACE
           SET ADDRESS OF LEDGER-BALANCE-OF-P1 TO ADDRESS OF
               SAVINGS-ACCOUNT
           PERFORM LEDGER-BALANCE-OF THRU LEDGER-BALANCE-OF-EXIT
           IF BANK-FAILURE-CODE NOT = SPACES
               GO TO WITHDRAW-BODY-EXIT
           END-IF
           COMPUTE BALANCE OF SAVINGS-ACCOUNT =
               (LEDGER-BALANCE-OF-RESULT - ALLOWED)
               ON SIZE ERROR
                   DISPLAY
                       "ARITHMETIC OVERFLOW BALANCE OF SAVINGS-ACCOUNT"
                       UPON SYSOUT
                   MOVE 12 TO BANK-RETURN-CODE
                   MOVE "ARITHMETIC-OVERFLOW" TO BANK-FAILURE-CODE
                   GO TO WITHDRAW-BODY-EXIT
           END-COMPUTE
           MOVE ACCOUNT-ID OF SAVINGS-ACCOUNT TO ACCOUNT-ID OF
               WITHDRAWAL-RESULT
           MOVE ALLOWED TO PAID-OUT OF WITHDRAWAL-RESULT
           MOVE BALANCE OF SAVINGS-ACCOUNT TO CLOSING-BALANCE OF
               WITHDRAWAL-RESULT
           MOVE IDEMPOTENCY-KEY OF SAVINGS-ACCOUNT TO IDEMPOTENCY-KEY OF
               WITHDRAWAL-RESULT
           OPEN OUTPUT RESULT-OUTPUT-FILE
           IF NOT RESULT-STATUS-OK
               DISPLAY "OPEN FAILED resultOutput STATUS " RESULT-STATUS
                   UPON SYSOUT
               MOVE 12 TO BANK-RETURN-CODE
               MOVE "OPEN-FAILED" TO BANK-FAILURE-CODE
               GO TO WITHDRAW-BODY-EXIT
           END-IF
           MOVE ACCOUNT-ID OF WITHDRAWAL-RESULT TO ACCOUNT-ID OF
               RESULT-OUTPUT-RECORD
           MOVE PAID-OUT OF WITHDRAWAL-RESULT TO PAID-OUT OF
               RESULT-OUTPUT-RECORD
           MOVE CLOSING-BALANCE OF WITHDRAWAL-RESULT TO CLOSING-BALANCE
               OF RESULT-OUTPUT-RECORD
           MOVE IDEMPOTENCY-KEY OF WITHDRAWAL-RESULT TO IDEMPOTENCY-KEY
               OF RESULT-OUTPUT-RECORD
           WRITE RESULT-OUTPUT-RECORD
           IF NOT RESULT-STATUS-OK
               DISPLAY "WRITE FAILED resultOutput STATUS " RESULT-STATUS
                   UPON SYSOUT
               MOVE 12 TO BANK-RETURN-CODE
               MOVE "WRITE-FAILED" TO BANK-FAILURE-CODE
               GO TO WITHDRAW-BODY-EXIT
           END-IF
           CLOSE RESULT-OUTPUT-FILE
           IF NOT RESULT-STATUS-OK
               DISPLAY "CLOSE FAILED resultOutput STATUS " RESULT-STATUS
                   UPON SYSOUT
               MOVE 12 TO BANK-RETURN-CODE
               MOVE "CLOSE-FAILED" TO BANK-FAILURE-CODE
               GO TO WITHDRAW-BODY-EXIT
           END-IF
           MOVE "WITHDRAWAL_POSTED" TO BANK-AUDIT-EVENT
           MOVE IDEMPOTENCY-KEY OF SAVINGS-ACCOUNT TO
               BANK-AUDIT-CORRELATION
           CALL "BANKAUDT" USING BANK-AUDIT-INTERFACE
           CONTINUE.
       WITHDRAW-BODY-EXIT.
           EXIT.
       WITHDRAW-FAILURE.
           MOVE "ROLLBK" TO BANK-LEDGER-OPERATION
           MOVE SPACES TO BANK-LEDGER-ACCOUNT
           MOVE 0 TO BANK-LEDGER-AMOUNT
           CALL "BANKLEDG" USING BANK-LEDGER-INTERFACE
           MOVE "WITHDRAWAL_REJECTED" TO BANK-AUDIT-EVENT
           MOVE IDEMPOTENCY-KEY OF SAVINGS-ACCOUNT TO
               BANK-AUDIT-CORRELATION
           CALL "BANKAUDT" USING BANK-AUDIT-INTERFACE
           CONTINUE.
       WITHDRAW-FAILURE-EXIT.
           EXIT.
