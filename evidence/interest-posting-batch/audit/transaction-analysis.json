{
  "version": 1,
  "backendProfile": "ibm-enterprise-cobol-zos",
  "transactions": [
    {
      "name": "postInterest",
      "parameters": ["account", "advice"],
      "ledgerPostings": [
        {
          "operation": "credit",
          "account": "account.accountId",
          "amount": "interest"
        },
        {
          "operation": "debit",
          "account": "INTEREST-EXPENSE",
          "amount": "interest"
        },
        {
          "operation": "debit",
          "account": "account.accountId",
          "amount": "fee"
        },
        {
          "operation": "credit",
          "account": "FEE-INCOME",
          "amount": "fee"
        }
      ],
      "auditEvents": [
        {
          "event": "INTEREST_POSTED",
          "correlation": "account.idempotencyKey"
        }
      ]
    },
    {
      "name": "runBatch",
      "parameters": ["account", "advice"],
      "ledgerPostings": [],
      "auditEvents": [
        {
          "event": "INTEREST_BATCH_COMPLETED",
          "correlation": "account.idempotencyKey"
        }
      ]
    }
  ],
  "status": "analyzed"
}
